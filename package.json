{
  "name": "@yhotamos/enja-cli",
  "version": "1.0.0",
  "description": "英語を日本語に翻訳するシンプルなコマンドラインツール",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "bin": {
    "enja": "dist/index.js"
  },
  "scripts": {
    "build": "tsup --no-sourcemap",
    "build:dev": "tsup",
    "watch": "tsup --watch"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "bundle": true,
    "minify": true,
    "treeshake": true,
    "external": [
      "commander",
      "kleur",
      "ora"
    ],
    "dts": true,
    "outDir": "dist",
    "clean": true,
    "sourcemap": true,
    "target": "node18"
  },
  "keywords": [
    "translation",
    "cli",
    "english",
    "japanese",
    "enja"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "yhotta240 <yhotta240@gmail.com> (https://github.com/yhotta240)",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhotamos/enja-cli.git"
  },
  "bugs": {
    "url": "https://github.com/yhotamos/enja-cli/issues"
  },
  "homepage": "https://github.com/yhotamos/enja-cli#readme",
  "dependencies": {
    "commander": "^14.0.2",
    "kleur": "^4.1.5",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
