{
  "name": "@yhotamos/enja-cli",
  "version": "1.3.1",
  "description": "英語を日本語に翻訳するシンプルなコマンドラインツール",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "bin": {
    "enja": "dist/index.js"
  },
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsup",
    "build:dev": "tsup --sourcemap",
    "watch": "tsup --watch",
    "test": "vitest"
  },
  "keywords": [
    "translation",
    "cli",
    "english",
    "japanese",
    "enja"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "yhotta240 <yhotta240@gmail.com> (https://github.com/yhotta240)",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhotamos/enja-cli.git"
  },
  "bugs": {
    "url": "https://github.com/yhotamos/enja-cli/issues"
  },
  "homepage": "https://github.com/yhotamos/enja-cli#readme",
  "dependencies": {
    "@google/genai": "^1.33.0",
    "commander": "^14.0.2",
    "kleur": "^4.1.5",
    "openai": "^6.9.1",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
